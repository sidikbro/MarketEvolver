# Public, disposable local-test defaults. Copy/export values; do not commit real credentials.
MARKET_EVOLVER_TEST_POSTGRES_URL=postgresql+psycopg://marketevolver_test:marketevolver_test_only@127.0.0.1:55432/marketevolver_test
MARKET_EVOLVER_DATABASE_URL=postgresql+psycopg://marketevolver_test:marketevolver_test_only@127.0.0.1:55432/marketevolver_test
MARKET_EVOLVER_ARTIFACT_ROOT=/tmp/marketevolver-test-artifacts
MARKET_EVOLVER_MARKET_ROOT=/tmp/marketevolver-test-market

# Telegram live validation is separate from deterministic tests. Keep real values local.
# MARKET_EVOLVER_TELEGRAM_LIVE_VALIDATION=YES
# MARKET_EVOLVER_TELEGRAM_API_ID=<operator-api-id>
# MARKET_EVOLVER_TELEGRAM_API_HASH=<operator-api-hash>
# MARKET_EVOLVER_TELEGRAM_SESSION_LOCATION=/absolute/path/to/protected-session-string.txt
# MARKET_EVOLVER_TELEGRAM_ALLOWLIST=/absolute/path/to/reviewed-public-sources.json
